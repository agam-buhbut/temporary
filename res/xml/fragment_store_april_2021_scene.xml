<?xml version="1.0" encoding="utf-8"?>
<MotionScene
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition app:constraintSetEnd="@id/collapsed" app:constraintSetStart="@id/expanded">
        <OnSwipe app:dragDirection="dragUp" app:touchAnchorId="@id/container" app:touchAnchorSide="top" />
    </Transition>
    <ConstraintSet android:id="@id/expanded">
        <Constraint android:id="@id/toolbar_bg" android:layout_height="200.0dip" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute app:attributeName="imageAlpha" app:customIntegerValue="220" />
        </Constraint>
        <Constraint android:id="@id/expandedText">
            <CustomAttribute app:attributeName="alpha" app:customFloatValue="1.0" />
        </Constraint>
        <Constraint android:id="@id/appbar_layout">
            <CustomAttribute app:attributeName="backgroundColor" app:customColorValue="@color/transparent" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@id/collapsed">
        <Constraint android:id="@id/toolbar_bg" android:layout_height="?actionBarSize" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute app:attributeName="imageAlpha" app:customIntegerValue="0" />
        </Constraint>
        <Constraint android:id="@id/expandedText">
            <CustomAttribute app:attributeName="alpha" app:customFloatValue="0.0" />
        </Constraint>
        <Constraint android:id="@id/appbar_layout">
            <CustomAttribute app:attributeName="backgroundColor" app:customColorValue="@color/transparent" />
        </Constraint>
    </ConstraintSet>
</MotionScene>