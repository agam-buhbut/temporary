<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/routine_nav.xml" app:startDestination="@id/routineOverviewFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:label="RoutineOverviewFragment" android:name="sp.repcount.activities.routine.RoutineOverviewFragment" android:id="@id/routineOverviewFragment">
        <action android:id="@id/action_routineOverviewFragment_to_routineExerciseFragment" app:destination="@id/routineExerciseFragment">
            <argument android:name="title" app:argType="string" />
            <argument android:name="routineId" app:argType="string" />
            <argument android:name="exerciseIds" app:argType="sp.repcount.database.realm.model.ref.RoutineExerciseRef[]" />
        </action>
    </fragment>
    <fragment android:label="{title}" android:name="sp.repcount.activities.routine.RoutineExerciseFragment" android:id="@id/routineExerciseFragment">
        <argument android:name="title" app:argType="string" />
        <argument android:name="routineId" app:argType="string" />
        <argument android:name="exerciseIds" app:argType="sp.repcount.database.realm.model.ref.RoutineExerciseRef[]" />
        <action android:id="@id/action_routineExerciseFragment_to_select_exercise_graph" app:destination="@id/select_exercise_graph">
            <argument android:name="routineExerciseIds" app:argType="sp.repcount.database.realm.model.ref.RoutineExerciseRef[]" />
        </action>
        <action android:id="@id/action_routineExerciseFragment_to_reorderRoutineExercisesSupersetFragment" app:destination="@id/reorderRoutineExercisesSupersetFragment">
            <argument android:name="id" app:argType="string" />
            <argument android:name="exerciseIds" app:argType="sp.repcount.database.realm.model.ref.RoutineExerciseRef[]" />
        </action>
    </fragment>
</navigation>